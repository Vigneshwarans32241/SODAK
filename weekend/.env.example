# Database Configuration (PostgreSQL)
# Local Docker or hosted PostgreSQL (Supabase / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_platform
# Fallback / Embedded Analytics Engine: duckdb:///placement_platform.duckdb

# Multi-Agent Platform Settings
APP_ENV=development
LOG_LEVEL=INFO

# Optional External AI Model Integration (OpenAI / Gemini)
# If empty, the system uses built-in high-precision deterministic heuristic & rule-based evaluator models
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
