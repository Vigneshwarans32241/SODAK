# ==========================================================================
# SoDak EduTech - Agentic AI Day 1
# Copy this file to ".env" and fill in ONE key. Never commit the .env file.
# ==========================================================================

# Which provider to use. Default is gemini - free, no credit card.
# Options: gemini | groq | ollama | openai
PROVIDER=gemini


# --- OPTION 1: Google Gemini  (RECOMMENDED - free, no card) ---------------
# Get a key in 30 seconds at https://aistudio.google.com/apikey
# Sign in with any Google account, click "Create API key". That is all.
GEMINI_API_KEY=paste-your-gemini-key-here

# Note: on the free tier Google may use your prompts to improve its models.
# Use the sample campus data in this project. Do not send real student records.


# --- OPTION 2: Groq  (also free, very fast) -------------------------------
# https://console.groq.com/keys
# GROQ_API_KEY=paste-your-groq-key-here

# --- OPTION 3: Ollama  (fully offline, no key, needs ~16GB RAM) -----------
# Install from https://ollama.com/download then:  ollama pull llama3.1
# No key needed - just set PROVIDER=ollama above.

# --- OPTION 4: OpenAI  (PAID - every call costs money) --------------------
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=paste-your-openai-key-here


# ==========================================================================
# Optional overrides. Leave commented out unless you have a reason.
# ==========================================================================

# Hitting "429 rate limit" during a lab? Use the lighter model for both.
# MODEL_MAIN=gemini-2.5-flash-lite
# MODEL_CHEAP=gemini-2.5-flash-lite

# Raise these if the whole class runs the same lab at the same moment.
# MAX_RETRIES=5
# RETRY_BASE_DELAY=3.0
